{
  "description": "Estructura que debe tener el JSON de entrada del generador de bug reports. Lo usa scripts/validate_input.py.",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 120,
      "help": "Titulo corto y especifico: [Componente] Que falla + cuando."
    },
    "summary": {
      "type": "string",
      "required": true,
      "min_length": 20,
      "help": "Resumen de 1-3 oraciones del problema y su impacto."
    },
    "component": {
      "type": "string",
      "required": false,
      "help": "Modulo o pantalla afectada (ej. Carrito, Login)."
    },
    "environment": {
      "type": "object",
      "required": true,
      "help": "Donde se reprodujo el defecto.",
      "fields": {
        "os": { "type": "string", "required": true, "help": "Sistema operativo (ej. Windows 11)." },
        "browser": { "type": "string", "required": false, "help": "Navegador y version." },
        "app_version": { "type": "string", "required": false, "help": "Version o commit de la aplicacion." },
        "url": { "type": "string", "required": false, "help": "URL o ruta donde ocurre." }
      }
    },
    "steps": {
      "type": "list",
      "required": true,
      "min_items": 2,
      "item_type": "string",
      "help": "Pasos para reproducir, uno por elemento, en orden."
    },
    "expected": {
      "type": "string",
      "required": true,
      "min_length": 5,
      "help": "Resultado esperado."
    },
    "actual": {
      "type": "string",
      "required": true,
      "min_length": 5,
      "help": "Resultado obtenido."
    },
    "severity": {
      "type": "string",
      "required": false,
      "enum": ["Crítica", "Alta", "Media", "Baja"],
      "help": "Si se omite, se sugiere con assets/severity_rules.json."
    },
    "priority": {
      "type": "string",
      "required": false,
      "enum": ["P1", "P2", "P3", "P4"],
      "help": "Si se omite, se deriva de la severidad."
    },
    "frequency": {
      "type": "string",
      "required": false,
      "enum": ["Siempre", "A veces", "Rara vez", "Una vez"],
      "help": "Con que frecuencia se reproduce."
    },
    "evidence": {
      "type": "list",
      "required": false,
      "item_type": "string",
      "help": "Capturas, logs o enlaces."
    },
    "reporter": {
      "type": "string",
      "required": false,
      "help": "Quien reporta."
    }
  }
}
